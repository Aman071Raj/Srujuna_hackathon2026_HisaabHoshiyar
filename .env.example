# ==============================================================================
# HisaabHoshiyaar Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# Supabase Auth & Supabase Postgres Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_KEY=your-anon-publishable-key

# Optional: Supabase Direct PostgreSQL Connection (AWS Pooler)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# AI Assistant (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email Reminders (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# SMS Reminders (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Server & CORS
CORS_ORIGINS=*
PORT=8000
